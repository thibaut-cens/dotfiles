{
  "layer": "top",
  "height": 20,
  "modules-left": [
    "cpu",
    "memory",
    "network",
    "mpris",
    "tray"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "reload_style_on_change": true,
  "modules-right": [
    "custom/mullvad",
    "backlight",
    "pulseaudio",
    "battery",
    "idle_inhibitor",
    "clock",
    "custom/updates",
  ],
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon} {volume}% {format_source}",
    "format-muted": "{icon} {format_source}",
    "format-bluetooth": " {icon} {volume}%  {format_source}",
    "format-bluetooth-muted": "<s> {icon}</s>  {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
      "default-muted": " ",
      "headset": "",
      "hdmi": "󰡁",
    },
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 {ipaddr}/{cidr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": " {signalStrength}% [{ipaddr}/{cidr}]",
    "tooltip-format-ethernet": "󰈀 {ifname}",
    "tooltip-format-disconnected": "Disconnected",
  },
  "backlight": {
    "tooltip": false,
    "format": " {}%",
    "interval": 1,
    "on-scroll-up": "light -A 5",
    "on-scroll-down": "light -U 5",
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": "󱐋 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
  },
  "clock": {
    "tooltip": false,
    "format": " {:%c}",
    "interval": 1
  },
  "cpu": {
    "interval": 5,
    "format": " {}%",
    "max-length": 10,
  },
  "memory": {
    "interval": 5,
    "format": "  {}%",
    "max-length": 10,
  },
  "mpris": {
    "format": "{player_icon} {status_icon}",
    "player-icons": {
      "default": "",
      "firefox": "",
      "spotify": "",
    },
    "status-icons": {
      "playing": "⏸",
      "paused": "▶",
    },
  },
  "custom/updates": {
    "format": "󰏖 {}",
    "exec": "checkupdates | wc -l",
    "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
    "interval": 300
  },
  "custom/mullvad": {
    "format": "{icon} {text}",
    "return-type": "json",
    "exec": "mullvad status -j | jq --unbuffered --compact-output '{ text: .details.location.country , alt : .state, class : [.state]}'",
    "on-click": "mullvad connect && killall -SIGUSR2 waybar",
    "on-click-right": "mullvad disconnect && killall -SIGUSR2 waybar",
    "format-icons": {
      "disconnected": "",
      "connected": "",
      "*": "?"
    },
    "interval": 5
  },
  "hyprland/workspaces": {
    "format": "{icon}:{windows}",
    "format-window-separator": "",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": " {icon}",
      "icon-size": 18,
    },
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰾪",
      "deactivated": ""
    }
  },
}
